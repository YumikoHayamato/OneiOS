<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- outside any app container, like the other helpers -->
  <key>com.apple.private.security.no-container</key><true/>
  <key>com.apple.private.security.no-sandbox</key><true/>
  <!-- register bundles with LaunchServices (the entitlements uicache carries) -->
  <key>com.apple.lsapplicationworkspace.rebuilddatabase</key><true/>
  <key>com.apple.private.coreservices.canmaplsdatabase</key><true/>
  <key>com.apple.private.MobileContainerManager.allowed</key><true/>
  <key>com.apple.private.security.storage.AppBundles</key><true/>
</dict>
</plist>
