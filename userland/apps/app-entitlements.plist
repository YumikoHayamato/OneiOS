<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>application-identifier</key><string>@BUNDLE_ID@</string>
  <!-- no container and no sandbox: the bundle is not installd's, and a sandbox profile may refuse the Metal device
       (droidvm-gpu-clients "*" opens the accelerator to every process, the sandbox decides first) -->
  <key>com.apple.private.security.no-container</key><true/>
  <key>com.apple.private.security.no-sandbox</key><true/>
  <!-- outside a sandbox the system policy still asks for the IOKit user clients by name (Settings, which also runs
       with no sandbox and no container, carries the same key): without it the Metal device is refused and
       MTLCreateSystemDefaultDevice returns nil. The graphics ones of SpringBoard's list. -->
  <key>com.apple.security.iokit-user-client-class</key>
  <array>
    <string>AGXCommandQueue</string>
    <string>AGXDevice</string>
    <string>AGXDeviceUserClient</string>
    <string>AGXSharedUserClient</string>
    <string>AppleJPEGDriverUserClient</string>
    <string>IOAccelContext</string>
    <string>IOAccelContext2</string>
    <string>IOAccelDevice</string>
    <string>IOAccelDevice2</string>
    <string>IOAccelSharedUserClient</string>
    <string>IOAccelSharedUserClient2</string>
    <string>IOAccelSubmitter2</string>
    <string>IOGPUDeviceUserClient</string>
    <string>IOMobileFramebufferUserClient</string>
    <string>IOSurfaceAcceleratorClient</string>
    <string>IOSurfaceRootUserClient</string>
  </array>
</dict>
</plist>
