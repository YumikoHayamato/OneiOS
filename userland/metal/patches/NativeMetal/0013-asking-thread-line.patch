+// OneiOS (metal2vulkan 0008, boot argument oneios-compile-here=1, docs/gpu.md 7.1): with METAL2VULKAN_COMPILE_ON_ASKING_THREAD=1 the
+// runtime makes a driver pipeline on the thread that asks for it only where that thread's stack holds 2 MiB or more, and hands it to a
+// thread of its own at the user-initiated class otherwise (as without the switch: device/compiles.rs at_user_initiated). Said once per
+// process, with the switch on: the asking thread's name, QoS class and stack, which tell whether the switch changes anything there.
+// Only reads of the thread's own pthread fields: no call a sandbox filters.
+static void noteAskingThread() {
+ static const bool on=[]{const char *value=getenv("METAL2VULKAN_COMPILE_ON_ASKING_THREAD");return value && !strcmp(value,"1");}();
+ static std::atomic<bool> said{false};
+ if(!on || said.exchange(true))return;
+ qos_class_t qos=QOS_CLASS_UNSPECIFIED;int relative=0;
+ pthread_get_qos_class_np(pthread_self(),&qos,&relative);
+ const size_t stack=pthread_get_stacksize_np(pthread_self());
+ char name[64]={};pthread_getname_np(pthread_self(),name,sizeof name);
+ NBLOG(@"native-metal: pipelines asked on thread '%s' (%s, QoS %#x%+d, %zu KiB of stack): the runtime makes them %s",name,
+       pthread_main_np()?"main":"secondary",(unsigned)qos,relative,stack>>10,
+       stack>=((size_t)2<<20)?"on it (oneios-compile-here=1)":"on a thread of its own still (under 2 MiB of stack)");
+}
