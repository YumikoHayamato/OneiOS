index d03940b..0d0463e 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -1349,12 +1349,35 @@ static int surfaceUseMode() {
  }();
  return mode;
 }
+// OneiOS (userland/metal/patches/NativeMetal/0016): with ONEIOS_DRAWABLE_RELEASE=1 (the boot argument oneios-drawable-release=1), an
+// app's CAMetalLayer drawable counts only while a command buffer reads it, in every mode above. QuartzCore names each drawable's surface
+// "CAMetalLayer Display Drawable" (get_unused_drawable -> CA::SurfaceUtil::CAIOSurfaceCreate: IOSurfaceSetValue(kIOSurfaceName)), and
+// counts it in use itself from its present (CAImageQueueInsertImage) until the render server gives it back (release_image).
+// get_unused_drawable hands out a presented drawable again only once IOSurfaceIsInUse is false; counted for the life of the render
+// server's texture over it, which Core Animation keeps in its image cache after it gave the drawable back, a layer's few drawables
+// stayed in use until those textures were collected, and nextDrawable timed out (Maps: "Failed to acquire drawable, rendering to
+// temporary texture"). Counted from each commit to its completion, a drawable goes back to its layer once the composition that read
+// it is done, as Apple's GPU does it. The name is read only with the switch on (an IOSurface call for each texture made over a surface).
+static bool layerDrawable(IOSurfaceRef surface) {
+ static const bool on=[]{const char *v=getenv("ONEIOS_DRAWABLE_RELEASE");return v && !strcmp(v,"1");}();
+ if(!on)return false;
+ CFTypeRef name=IOSurfaceCopyValue(surface,CFSTR("IOSurfaceName"));
+ const bool drawable=name && CFGetTypeID(name)==CFStringGetTypeID() && CFEqual(name,CFSTR("CAMetalLayer Display Drawable"));
+ if(name)CFRelease(name);
+ static std::atomic<uint64_t> said;
+ if(drawable && said++<4) {
+  const OSType f=IOSurfaceGetPixelFormat(surface);
+  NBLOG(@"native-metal: CAMetalLayer drawable %lux%lu '%c%c%c%c': in use only while a command buffer reads it (oneios-drawable-release=1)",
+        (unsigned long)IOSurfaceGetWidth(surface),(unsigned long)IOSurfaceGetHeight(surface),(char)(f>>24),(char)(f>>16),(char)(f>>8),(char)f);
+ }
+ return drawable;
+}
 static bool surfaceUseByCommand(IOSurfaceRef surface) {
  if(!surface || !gCountsSurfaceUse)return false;
- switch(surfaceUseMode()) {
-  case 0:return false;
-  case 2:return true;
- }
+ const int mode=surfaceUseMode();
+ if(mode==2)return true;
+ if(layerDrawable(surface))return true;   // OneiOS 0016
+ if(mode==0)return false;
  if(IOSurfaceGetPlaneCount(surface)!=2)return false;
  const size_t luma=IOSurfaceGetBytesPerElementOfPlane(surface,0),chroma=IOSurfaceGetBytesPerElementOfPlane(surface,1);
  return (luma==1 || luma==2) && chroma==2*luma;
