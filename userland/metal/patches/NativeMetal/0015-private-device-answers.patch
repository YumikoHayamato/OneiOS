+/// OneiOS (userland/metal/patches/NativeMetal/0015): the bridge's own answers to five of Apple's private device queries that the runtime
+/// leaves without one (`PrivateAnswer::Metal`: no document says what they promise, so its value is Apple's GPU's, never this device's).
+/// Unanswered, the device class inherits _MTLDevice's: `isLargeMRTSupported` is NO there, `maxComputeThreadgroupMemory` and
+/// `maxVertexAmplificationCount` read its `limits`, which the frontend's empty initLimits leaves zero, and the two flags ask its GPU
+/// family object, which the empty initGPUFamilySupport leaves nil. Those zeros contradicted the device's own public answers. Each answer
+/// is held to what the runtime does on the device, the smaller one where Metal's would claim more. ONEIOS_DEVICE_ANSWERS=0 (the boot
+/// argument oneios-device-answers=0) leaves them unanswered, as before.
+fn oneios_private_answer(device: &NmbDevice, selector: &str) -> Option<u64> {
+    static WANTED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*WANTED.get_or_init(|| std::env::var("ONEIOS_DEVICE_ANSWERS").map_or(true, |value| value.trim() != "0")) {
+        return None;
+    }
+    let p = device.0.properties();
+    let l = &p.description.limits;
+    Some(match selector {
+        // Metal's measured 2 (the public supportsVertexAmplificationCount: takes 1 to 8 on that GPU too): two amplifications are one
+        // multiview pass where the device has `multiview` (Turnip's maxMultiviewViewCount is 6), and the runtime draws up to 8 (past the
+        // device's views as draws of one amplification each). 1 without multiview, where only a count of 1 is taken.
+        "maxVertexAmplificationCount" => {
+            if p.supports_vertex_amplification_count(2) == Ok(true) {
+                2
+            } else {
+                1
+            }
+        }
+        // The most threadgroup memory one threadgroup is given: the public maxThreadgroupMemoryLength (the device's
+        // maxComputeSharedMemorySize, 32 KiB on the Adreno 830). Metal's 64 KiB is twice its public length on Apple's GPUs; a kernel
+        // sized by it would be refused here.
+        "maxComputeThreadgroupMemory" => p.max_threadgroup_memory_length,
+        // More than Apple1's four color attachments in one pass: the runtime's pass takes maxColorAttachments (8 on Turnip).
+        "isLargeMRTSupported" => {
+            ((MAX_COLOR_ATTACHMENTS as u64).min(l.max_color_attachments.min(l.max_fragment_output_attachments) as u64) > 4) as u64
+        }
+        // A kernel's writes keeping a texture's lossless compression: the runtime makes no Apple-compressed texture. No, as an M3 Max.
+        "supportsComputeCompressedTextureWrite" => 0,
+        // No document or AIR form names it, so no path a client would take on a yes is known to run here: no.
+        "supportsConditionalLoadStore" => 0,
+        _ => return None,
+    })
+}
+
 fn device_answer(device: &NmbDevice, selector: &str, arg: u64) -> Result<u64, String> {
     let d = &device.0;
     let p = d.properties();
     let none = || format!("the device has no answer for {selector}");
     if let Some(c) = PrivateCount::ALL.into_iter().find(|c| c.selector() == selector) {
-        return device.private().count(c).value().ok_or_else(none);
+        return device.private().count(c).value().or_else(|| oneios_private_answer(device, selector)).ok_or_else(none);
     }
     if let Some(f) = PrivateFlag::ALL.into_iter().find(|f| f.selector() == selector) {
-        return device.private().flag(f).value().map(u64::from).ok_or_else(none);
+        return device
+            .private()
+            .flag(f)
+            .value()
+            .map(u64::from)
+            .or_else(|| oneios_private_answer(device, selector))
+            .ok_or_else(none);
     }
     let gap = |r: Result<bool, metal2vulkan_runtime::RuntimeGap>| r.map(u64::from).map_err(|g| format!("{selector}: {g:?}"));
     let format_supported = |f: PixelFormat| d.pixel_format_capabilities(f) != metal2vulkan_runtime::FormatCapabilities::NONE;
