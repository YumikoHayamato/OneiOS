  @synchronized(gInFlight){[gInFlight removeObject:self];}
  // Surfaces this command buffer kept alive may now have no other owner: their held imports go.
@@ -3578,6 +3620,12 @@ static void noteSampleBuffers(id attachments,const char *what) {
  if(self.committed){NBLOG(@"native-metal: commit twice");return;}
  self.committed=YES;
  self.committedUs=nowUs();
+ // OneiOS: the surfaces of its commandUse textures are in use from here, on the caller's thread, to its completion (finish).
+ for(NBTexture *texture in _surfaces)
+  if(texture.commandUse && texture.surface) {
+   if(!_surfacesInUse)_surfacesInUse=[NSMutableArray array];
+   IOSurfaceIncrementUseCount(texture.surface);[_surfacesInUse addObject:texture];
+  }
  commitCpu=threadCpuUs();commitTid=threadIdLow();sampleWindowClose();
  {
   std::lock_guard<std::mutex> lock(gCommitLock);
@@ -4601,6 +4649,12 @@ static bool pipelineArchives(NSArray *list,std::vector<NmbBinaryArchive *> &arch
  NBTexture *texture=planes>=2?textureOnSurface(buffer,d,surface,plane,start-(uintptr_t)base,row):textureOnBuffer(buffer,d,start-(uintptr_t)base,row,true);
  if(!texture){refuseSurface(5,surface,d,plane,start-(uintptr_t)base,row);return nil;}
  if(gLogTextures)logTexture("iosurface",d,surface,plane,base,start-(uintptr_t)base,row,texture!=nil);
+ if(surfaceUseByCommand(surface)) {   // OneiOS: in use while a command buffer reads it (surfaceUseMode)
+  if(gSurfacesByCommand++<4)NBLOG(@"native-metal: surface texture %lux%lu format %lu over a %c%c%c%c surface: in use while a command buffer reads it",
+   (unsigned long)d.width,(unsigned long)d.height,(unsigned long)d.pixelFormat,(char)(IOSurfaceGetPixelFormat(surface)>>24),
+   (char)(IOSurfaceGetPixelFormat(surface)>>16),(char)(IOSurfaceGetPixelFormat(surface)>>8),(char)IOSurfaceGetPixelFormat(surface));
+  gSurfaceTextures++;texture.surface=(IOSurfaceRef)CFRetain(surface);texture.commandUse=YES;return (id<MTLTexture>)texture;
+ }
  gSurfaceTextures++;texture.surface=(IOSurfaceRef)CFRetain(surface);[texture countUse];return (id<MTLTexture>)texture;
 }
