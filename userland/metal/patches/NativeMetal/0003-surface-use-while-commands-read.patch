+// OneiOS (Droid-VM/macOS-DroidVM 4f77b11, NativeMetal 43f78ae, for iOS's render server): a surface whose texture the render server
+// keeps may be counted in use only while a command buffer that reads it runs (commandUse), from its commit (on the caller's thread,
+// so the work queued before the encoding thread submits it is covered) to its completion or local refusal (NBCommandBuffer finish),
+// not for the texture's life (countUse). Apart from the interface above, which the base's build-adreno-metal-plugin.py finds as it
+// wrote it.
+@interface NBTexture ()
+@property(nonatomic) BOOL commandUse;
+@end
+// Which surface textures of the render server count only while command buffers read them: ONEIOS_SURFACE_USE (the boot argument
+// oneios-surface-use=, userland/metal/Switches.inc). "video", the default: a surface of two planes whose second plane's elements are
+// twice its first's (4:2:0, 4:2:2 and 4:4:4 two-plane YCbCr, 8 and 10 bit: '420v', '420f', 'x420' ...), whatever format the texture
+// reads it as (a YCbCr format, or R8 and RG8 over each plane). Those are a video decoder's or a camera's pool (CAImageQueue, AVPlayer's
+// layers): counted for the textures' life, as before, none of them came back to the pool while the render server kept their textures,
+// so VideoToolbox made more, each with its runtime texture (take17, YouTube at 1080p: backboardd's GPU blobs at 1885 of its 2048 MiB,
+// 9,399 'texture over surface refused: OutOfMemory(Device)', the picture black). An app's own backing stores (BGRA, 'b3a8'
+// RGB10+A8: one plane, or a second plane of narrower elements) keep the life count: an app's Core Animation draws into a backing store
+// in place, or recycles it, only while it is not in use, and Settings showed torn labels without it. "all": every surface texture of
+// the render server (Droid-VM/macOS-DroidVM 4f77b11's macOS rule; an A/B, it may bring those labels back). "life": none, as before.
+static int surfaceUseMode() {
+ static const int mode=[]{
+  const char *v=getenv("ONEIOS_SURFACE_USE");
+  if(v && !strcmp(v,"life"))return 0;
+  if(v && !strcmp(v,"all"))return 2;
+  return 1;
+ }();
+ return mode;
+}
+static bool surfaceUseByCommand(IOSurfaceRef surface) {
+ if(!surface || !gCountsSurfaceUse)return false;
+ switch(surfaceUseMode()) {
+  case 0:return false;
+  case 2:return true;
+ }
+ if(IOSurfaceGetPlaneCount(surface)!=2)return false;
+ const size_t luma=IOSurfaceGetBytesPerElementOfPlane(surface,0),chroma=IOSurfaceGetBytesPerElementOfPlane(surface,1);
+ return (luma==1 || luma==2) && chroma==2*luma;
+}
+static std::atomic<uint64_t> gSurfacesByCommand;   // surface textures made commandUse (the first ones said in the log)
