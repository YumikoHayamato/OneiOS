+/// The command buffers a pool may hold past the most one command buffer used of it in a
+/// [`USE_WINDOW`] before it is released (OneiOS).
+pub(super) const USE_SLACK: usize = 8;
+
+/// The process's command pools and their command buffers, for the board's report (OneiOS,
+/// [`m2v_command_pool_census`]): live pools, the command buffers made from them, pools released
+/// for holding past their use and their command buffers, pools released idle (the trim) and theirs.
+static CENSUS: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+const LIVE_POOLS: usize = 0;
+const LIVE_BUFFERS: usize = 1;
+const CUT_POOLS: usize = 2;
+const CUT_BUFFERS: usize = 3;
+const TRIMMED_POOLS: usize = 4;
+const TRIMMED_BUFFERS: usize = 5;
+
+fn census_add(at: usize, count: usize) {
+    CENSUS[at].fetch_add(count as u64, Ordering::Relaxed);
+}
+
+fn census_sub(at: usize, count: usize) {
+    // Saturating: a pool made before a count began (none here) never takes it below zero.
+    let _ = CENSUS[at].fetch_update(Ordering::Relaxed, Ordering::Relaxed, |now| {
+        Some(now.saturating_sub(count as u64))
+    });
+}
+
+/// Whether a pool holding `held` command buffers, of which one command buffer used at most `peak`
+/// in the window, holds past its use (the module docs).
+pub(super) fn past_use(held: usize, peak: usize) -> bool {
+    held > peak.saturating_add(USE_SLACK)
+}
+
+/// OneiOS: the process's command pools, into `out` (`count` words, at most 6): live pools, the
+/// command buffers made from them, pools released for holding past their recent use and their
+/// command buffers, pools released idle and theirs. The words written.
+#[unsafe(no_mangle)]
+pub extern "C" fn m2v_command_pool_census(out: *mut u64, count: usize) -> usize {
+    if out.is_null() {
+        return 0;
+    }
+    let n = count.min(CENSUS.len());
+    for (at, word) in CENSUS.iter().take(n).enumerate() {
+        // SAFETY: the caller's `count` words at `out`.
+        unsafe { *out.add(at) = word.load(Ordering::Relaxed) };
+    }
+    n
+}
