+/// The census counts the command buffers made from live pools (OneiOS; other tests make pools too,
+/// so only the growth is checked).
+#[test]
+fn the_census_counts_made_command_buffers() {
+    let mut before = [0u64; 6];
+    assert_eq!(m2v_command_pool_census(before.as_mut_ptr(), 6), 6);
+    let mut pool = CommandPool::new(vk::CommandPool::from_raw(1), 0);
+    pool.made(
+        vk::CommandBufferLevel::PRIMARY,
+        vk::CommandBuffer::from_raw(1),
+    );
+    pool.stock_secondary(vk::CommandBuffer::from_raw(2));
+    let mut after = [0u64; 6];
+    assert_eq!(m2v_command_pool_census(after.as_mut_ptr(), 6), 6);
+    assert!(after[0] >= 1 && after[1] >= 2, "{before:?} -> {after:?}");
+    assert_eq!(m2v_command_pool_census(std::ptr::null_mut(), 6), 0);
+    let mut two = [0u64; 2];
+    assert_eq!(m2v_command_pool_census(two.as_mut_ptr(), 2), 2);
+}
