+
+/// A pool holds past its use when it holds more than the most one command buffer used of it in
+/// the window plus the slack (OneiOS).
+#[test]
+fn a_pool_holds_past_its_use_beyond_the_slack() {
+    assert!(!past_use(0, 0));
+    assert!(!past_use(USE_SLACK, 0));
+    assert!(past_use(USE_SLACK + 1, 0));
+    assert!(!past_use(40 + USE_SLACK, 40));
+    assert!(past_use(41 + USE_SLACK, 40));
+    assert!(!past_use(usize::MAX, usize::MAX), "no overflow");
+}
+
+/// A pool given back is followed for a window: inside it never goes; at the first give-back past
+/// it, it goes only where it holds more than the window's most used plus the slack, and a new
+/// window begins either way (OneiOS).
+#[test]
+fn a_pool_goes_only_past_the_window_and_past_its_use() {
+    let primary = vk::CommandBufferLevel::PRIMARY;
+    let secondary = vk::CommandBufferLevel::SECONDARY;
+    let start = Instant::now();
+    // A command buffer of 1 primary and 40 secondaries made the pool (an app's opening).
+    let mut pool = CommandPool::new(vk::CommandPool::from_raw(1), 0);
+    pool.made(primary, vk::CommandBuffer::from_raw(1));
+    for n in 0..40 {
+        pool.made(secondary, vk::CommandBuffer::from_raw(100 + n));
+    }
+    assert_eq!(pool.held(), 41);
+    assert!(!pool.holds_past_use(start, USE_WINDOW), "the window begins");
+    // Then frames of 1 primary and 2 secondaries.
+    let frame = |pool: &mut CommandPool| {
+        pool.taken();
+        assert!(pool.reuse(primary).is_some());
+        assert!(pool.reuse(secondary).is_some());
+        assert!(pool.reuse(secondary).is_some());
+    };
+    frame(&mut pool);
+    assert!(
+        !pool.holds_past_use(start + USE_WINDOW / 2, USE_WINDOW),
+        "inside the window, whatever it holds"
+    );
+    frame(&mut pool);
+    assert!(
+        !pool.holds_past_use(start + USE_WINDOW, USE_WINDOW),
+        "the window's most used was the 41 of its making"
+    );
+    frame(&mut pool);
+    assert!(
+        pool.holds_past_use(start + USE_WINDOW * 2, USE_WINDOW),
+        "41 held against 3 used in the window, past the slack"
+    );
+}
+
+/// A pool that serves the same command buffers frame after frame never goes (OneiOS).
+#[test]
+fn a_pool_in_steady_use_stays() {
+    let primary = vk::CommandBufferLevel::PRIMARY;
+    let secondary = vk::CommandBufferLevel::SECONDARY;
+    let start = Instant::now();
+    let mut pool = CommandPool::new(vk::CommandPool::from_raw(1), 0);
+    pool.made(primary, vk::CommandBuffer::from_raw(1));
+    for n in 0..30 {
+        pool.made(secondary, vk::CommandBuffer::from_raw(100 + n));
+    }
+    for second in 0..60u64 {
+        if second > 0 {
+            pool.taken();
+            assert!(pool.reuse(primary).is_some());
+            for _ in 0..30 {
+                assert!(pool.reuse(secondary).is_some());
+            }
+        }
+        assert!(!pool.holds_past_use(start + Duration::from_secs(second), USE_WINDOW));
+    }
+}
