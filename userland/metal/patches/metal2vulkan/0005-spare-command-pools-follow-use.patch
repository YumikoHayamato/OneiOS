+/// How long a command pool's use is followed before a give-back may release it for holding more
+/// than that use (OneiOS, the module docs).
+pub(super) const USE_WINDOW: Duration = Duration::from_secs(10);
+
+/// The window in this process: [`USE_WINDOW`], or `METAL2VULKAN_POOL_USE_WINDOW_S` seconds where the process
+/// sets it (1 to 3600); 0 turns the release off, the pools kept as before (the board's switch: the
+/// plug-in sets 0 for the boot argument `oneios-pool-cut=0`).
+pub(super) fn use_window() -> Option<Duration> {
+    static WINDOW: std::sync::OnceLock<Option<Duration>> = std::sync::OnceLock::new();
+    *WINDOW.get_or_init(|| {
+        match std::env::var("METAL2VULKAN_POOL_USE_WINDOW_S")
+            .ok()
+            .and_then(|text| text.trim().parse::<u64>().ok())
+        {
+            Some(0) => None,
+            Some(seconds) if seconds <= 3600 => Some(Duration::from_secs(seconds)),
+            _ => Some(USE_WINDOW),
+        }
+    })
+}
