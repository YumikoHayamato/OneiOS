+    static WANTED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *WANTED.get_or_init(|| std::env::var("ONEIOS_REGION_IDENTITY").map_or(true, |value| value.trim() != "0"))
+}
