+/// The identity through `mach_vm_region` (OneiOS): for each map entry over the range, VM_REGION_TOP_INFO's object id and
+/// VM_REGION_BASIC_INFO_64's offset, hashed as `pages_identity_recurse` hashes them. Neither flavor walks the entry's pages
+/// (xnu-12377 osfmk/vm/vm_map.c vm_map_region: the top walk follows the shadow chain only), unlike proc_pidinfo's
+/// PROC_PIDREGIONINFO, which walks every page of the entry (fill_procregioninfo -> vm_map_region_walk). The top info's id is the
+/// bottom object of the entry's shadow chain (vm_map_region_top_walk), the recursion's the entry's own object: they are the same
+/// object only where the entry has no shadow and needs no copy, which the top info's share mode says (anything but SM_COW and
+/// SM_EMPTY); elsewhere, and for a submap entry (not descended here), the answer is `None`, a remap, as without the identity.
+/// `Err` where the call is refused.
+#[cfg(target_vendor = "apple")]
+fn pages_identity_region(start: u64, length: u64) -> Result<Option<u64>, ()> {
+    use std::hash::{Hash, Hasher};
+    const VM_REGION_BASIC_INFO_64: i32 = 9;
+    const VM_REGION_TOP_INFO: i32 = 12;
+    const SM_COW: u8 = 1;
+    const SM_EMPTY: u8 = 3;
+    // vm_region_top_info (mach/vm_region.h, packed to 4): 5 words.
+    #[repr(C, packed(4))]
+    #[derive(Default)]
+    struct Top {
+        obj_id: u32,
+        ref_count: u32,
+        private_pages_resident: u32,
+        shared_pages_resident: u32,
+        share_mode: u8,
+    }
+    // vm_region_basic_info_64 (mach/vm_region.h, packed to 4): 9 words.
+    #[repr(C, packed(4))]
+    #[derive(Default)]
+    struct Basic {
+        protection: i32,
+        max_protection: i32,
+        inheritance: u32,
+        shared: u32,
+        reserved: u32,
+        offset: u64,
+        behavior: i32,
+        user_wired_count: u16,
+    }
+    let Some(end) = start.checked_add(length) else { return Ok(None) };
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    let mut at = start;
+    while at < end {
+        let (mut address, mut size, mut name) = (at, 0u64, 0u32);
+        let mut top = Top::default();
+        let mut count = (std::mem::size_of::<Top>() / 4) as u32;
+        // SAFETY: the out-parameters are this frame's, `count` words of `top`; the call reads no memory of the range.
+        let status = unsafe {
+            mach_vm_region(mach_task_self_, &mut address, &mut size, VM_REGION_TOP_INFO, (&raw mut top).cast(), &mut count, &mut name)
+        };
+        if refused(status) {
+            return Err(());
+        }
+        let (object, mode) = (top.obj_id, top.share_mode);
+        if status != 0 || address > at || object == 0 || mode == SM_COW || mode == SM_EMPTY {
+            return Ok(None);
+        }
+        let (mut again, mut again_size, mut again_name) = (at, 0u64, 0u32);
+        let mut basic = Basic::default();
+        let mut count = (std::mem::size_of::<Basic>() / 4) as u32;
+        // SAFETY: as above, `count` words of `basic`.
+        let status = unsafe {
+            mach_vm_region(mach_task_self_, &mut again, &mut again_size, VM_REGION_BASIC_INFO_64, (&raw mut basic).cast(), &mut count,
+                           &mut again_name)
+        };
+        if refused(status) {
+            return Err(());
+        }
+        // The same entry both times (the map may change between the two calls), or no answer.
+        if status != 0 || again != address || again_size != size {
+            return Ok(None);
         }
+        let offset = basic.offset;
         (at, object, offset + (at - address)).hash(&mut hash);
-        at = address.checked_add(size)?;
+        let Some(next) = address.checked_add(size) else { return Ok(None) };
+        at = next;
     }
-    Some(hash.finish())
+    Ok(Some(hash.finish()))
 }
 
