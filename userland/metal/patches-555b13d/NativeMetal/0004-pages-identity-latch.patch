+///
+/// OneiOS: a process whose sandbox refuses the kernel's `mach_vm_region_recurse` (WebKit's GPU process: its kernel MIG filter
+/// allows `mach_vm_region` and not the recursion; take17's log has 20,018 'deny(1) syscall-mig 319', two at every no-copy
+/// buffer, each a violation report) got `None` for every range, so every no-copy buffer was reported remapped and imported
+/// anew. The first status other than an answer (`KERN_SUCCESS`) or the end of the map (`KERN_INVALID_ADDRESS`) is latched
+/// (`RECURSE_REFUSED`) and the call is not made again in the process; the identity then comes from `mach_vm_region`
+/// (`pages_identity_region`), whose answer is the same where it can be trusted, and is `None` (a remap, the old correct but
+/// costly answer) where it cannot or where that call is refused too (latched the same way). ONEIOS_REGION_IDENTITY=0 (the boot
+/// argument oneios-region-identity=0, userland/metal/Switches.inc) leaves the second source out.
+#[cfg(target_vendor = "apple")]
+static RECURSE_REFUSED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+#[cfg(target_vendor = "apple")]
+static REGION_REFUSED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// A Mach answer: KERN_SUCCESS (0) and KERN_INVALID_ADDRESS (1, no entry at or past the address) are the kernel's own answers;
+/// anything else (a sandbox's refusal of the MIG routine, MACH_SEND_* errors) says the routine is not this process's to call.
+#[cfg(target_vendor = "apple")]
+fn refused(status: i32) -> bool {
+    status != 0 && status != 1
+}
+
+#[cfg(target_vendor = "apple")]
+unsafe extern "C" {
+    static mach_task_self_: u32;
+    fn mach_vm_region_recurse(task: u32, address: *mut u64, size: *mut u64, depth: *mut u32, info: *mut i32, count: *mut u32) -> i32;
+    fn mach_vm_region(task: u32, address: *mut u64, size: *mut u64, flavor: i32, info: *mut i32, count: *mut u32,
+                      object_name: *mut u32) -> i32;
+}
+
 #[cfg(target_vendor = "apple")]
 fn pages_identity(start: u64, length: u64) -> Option<u64> {
+    use std::sync::atomic::Ordering::Relaxed;
+    if !RECURSE_REFUSED.load(Relaxed) {
+        match pages_identity_recurse(start, length) {
+            Ok(identity) => return identity,
+            Err(()) => RECURSE_REFUSED.store(true, Relaxed),
+        }
+    }
+    if REGION_REFUSED.load(Relaxed) || !region_identity_wanted() {
+        return None;
+    }
+    match pages_identity_region(start, length) {
+        Ok(identity) => identity,
+        Err(()) => {
+            REGION_REFUSED.store(true, Relaxed);
+            None
+        }
+    }
+}
