 #[unsafe(no_mangle)]
@@ -648,6 +655,17 @@ pub unsafe extern "C" fn nmb_device_open(loader: *const c_char, cache: *const c_
         // default (PipelineWaitPolicy::Bounded) drops the draws and dispatches of a pipeline not made 4.5 s after the commit, which the
         // render server showed as missing pieces of the screen while it compiled (int 590aaee2).
         options.policy.pipeline_waits = metal2vulkan::device::PipelineWaitPolicy::Exact;
+        // OneiOS (patches-555b13d/NativeMetal/0010, opt-in): ONEIOS_PIPELINE_WAIT_MS=N takes the runtime's own default instead,
+        // PipelineWaitPolicy::Bounded, with N ms for both waits. Under Exact a state's creation makes its pipeline on the
+        // calling thread before it returns (pipeline/render.rs settle_graphics_pipeline, make_at_creation's `joined`); under
+        // Bounded it hands the making to the runtime's pool and waits N ms at most, and a command buffer committed N ms ago
+        // records the draws whose pipeline is still being made as nothing (counted, `draw-dropped-still-making`). So a frame
