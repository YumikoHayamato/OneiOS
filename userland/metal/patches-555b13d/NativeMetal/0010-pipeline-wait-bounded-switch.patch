+/// OneiOS (patches-555b13d/NativeMetal/0010): `ONEIOS_PIPELINE_WAIT_MS` (the boot argument `oneios-pipeline-wait-ms=N`, which
+/// userland/metal/Switches-555b13d.inc sets in the render server alone), 1 to 4500; `None` without it: the bridge's `Exact`.
+fn oneios_pipeline_wait() -> Option<std::time::Duration> {
+    let ms = std::env::var("ONEIOS_PIPELINE_WAIT_MS").ok()?.trim().parse::<u64>().ok()?;
+    (1..=4500).contains(&ms).then(|| std::time::Duration::from_millis(ms))
+}
