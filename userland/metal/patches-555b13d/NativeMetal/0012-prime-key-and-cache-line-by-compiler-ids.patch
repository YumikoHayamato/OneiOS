 }
+// OneiOS 0012: what the shader cache kept from earlier boots did for this one, said in iOS's log without any switch: the render server's
+// counts of translations and driver pipeline data found in the cache directory, not found (made new) and written, and the two ids
+// the kept files are named by (the translator's source, nmb_runtime_build; Turnip's pipeline cache id, ONEIOS_TURNIP_BUILD). Two
+// builds that print the same two ids read each other's files: a first boot of the newer one then finds nearly everything.
+// `native-metal: shader cache (WHEN): F found, N not found, W written; kept by translator T, Turnip U`
+#if __has_include("OneiOSTurnipBuild.h")
+#include "OneiOSTurnipBuild.h"
+#endif
+#ifndef ONEIOS_TURNIP_BUILD
+#define ONEIOS_TURNIP_BUILD ""
+#endif
+static void oneiosCacheSay(const char *when) {
+ uint64_t work[10]={};
+ if(!gDevice || !nmb_device_work_stats(gDevice,work))return;
+ const char *turnip=ONEIOS_TURNIP_BUILD;
+ NBLOG(@"native-metal: shader cache (%s): %llu found, %llu not found, %llu written; kept by translator %.12s, Turnip %.12s",when,
+       (unsigned long long)work[7],(unsigned long long)work[8],(unsigned long long)work[9],nmb_runtime_build(),turnip[0]?turnip:"(its LC_UUID)");
+}
 void oneiosKeepState(MTLRenderPipelineDescriptor *d,id state) {
+ if(isRenderServer()) {   // once a boot, with or without oneios-prewarm
+  static std::atomic<bool> asked{false};
+  if(!asked.exchange(true))
+   dispatch_after(dispatch_time(DISPATCH_TIME_NOW,(int64_t)(60*NSEC_PER_SEC)),dispatch_get_global_queue(QOS_CLASS_UTILITY,0),^{
+    oneiosCacheSay("60 s after the first render pipeline");});
+ }
  if(!prewarmOn() || !state)return;
  std::string line;bool record=false;
  {std::lock_guard<std::mutex> lock(gKeptLock);
@@ -7451,5 +7475,6 @@ static void prewarmStart() {
   NBLOG(@"native-metal: prewarm: %u of %zu descriptors made in %llu ms (%u refused, %u already kept)",made,lines.size(),
         (unsigned long long)((nowUs()-began)/1000),refused,kept);
   if(archiveOn())archiveSay("at the boot pass's end");
+  oneiosCacheSay("at the boot pass's end");
  });
 }
