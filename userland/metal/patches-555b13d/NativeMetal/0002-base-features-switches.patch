-        if (bootArgSet("gpu-ycbcr-planes=0")) setenv("NATIVE_METAL_YCBCR_PLANES", "0", 1);
+        // (OneiOS: its take18 name for the same, oneios-ycbcr-planes=0, is taken too.)
+        if (bootArgSet("gpu-ycbcr-planes=0") || bootArgSet("oneios-ycbcr-planes=0")) setenv("NATIVE_METAL_YCBCR_PLANES", "0", 1);
         else unsetenv("NATIVE_METAL_YCBCR_PLANES");
