+        // take18 plug-in did without oneios-compile-here=1.
+        if (bootArgSet("oneios-compile-here=0")) unsetenv("METAL2VULKAN_COMPILE_ON_ASKING_THREAD");
+        else setenv("METAL2VULKAN_COMPILE_ON_ASKING_THREAD", "1", 1);
