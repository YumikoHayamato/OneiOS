+// OneiOS (patches-555b13d/NativeMetal/0008, take20's 0017): a client whose temporary directory is one the boot empties, and which
+// may not write the same-user shared directory the base tries first (SharedShaderCache.h: ~/Library/Caches/org.unixnu.metal, kept
+// across boots and shared), keeps its cache in its home's Library/Caches instead. launchd's boot task dirs_cleaner empties /private/var/mobile/tmp (and /private/var/tmp, /tmp) at every
+// boot, and a client's confstr cache directory is empty on iOS, so SpringBoard and the mobile daemons (cameracaptured,
+// mediaplaybackd, chrono, messages) compiled their pipelines again at each boot: take19's store had the 51 entries of
+// /var/mobile/tmp/m2v and cameracaptured's 52 written again at its boot, take18's the same 52 and 214 (/var/mobile/tmp/m2v over
+// its session). The render server left that directory before (marker 0x6814, ~/Library/Caches/com.apple.backboardd); a client
+// now does the same: $HOME/Library/Caches/<its folder>/m2v, <its folder> the temporary directory's own (com.apple.cameracaptured)
+// or else the bundle identifier (com.apple.springboard) or the process's name. Where that cannot be made or written (a sandbox),
+// the earlier order stands; an app's container tmp/m2v (kept across boots) is left as it is. ONEIOS_CLIENT_CACHE=temp (boot
+// argument oneios-client-cache=temp, Switches.inc): the earlier order always. The client's text line says the folder taken
+// (oneios-gpu-text: "<process> cache Library/Caches/<its folder>").
+static size_t clientTempEmptiedAtBoot(const char *dir) {
+    static const char *const emptied[] = {"/private/var/mobile/tmp/", "/var/mobile/tmp/", "/private/var/tmp/", "/var/tmp/", "/private/tmp/", "/tmp/"};
+    for (const char *prefix : emptied)
+        if (!strncmp(dir, prefix, strlen(prefix))) return strlen(prefix);
+    return 0;
+}
+static bool clientCacheName(const char *name) {
+    if (!name[0] || !strcmp(name, ".") || !strcmp(name, "..")) return false;
+    for (const char *c = name; *c; ++c)
+        if (!((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') || *c == '.' || *c == '_' || *c == '-')) return false;
+    return true;
+}
+// The persistent folder for a client whose temporary directory is `temp`, with its trailing '/' (the caller adds "m2v"), into
+// out; empty when there is none to take.
+static void clientPersistentCache(const char *temp, char *out, size_t size) {
+    out[0] = 0;
+    if (const char *mode = getenv("ONEIOS_CLIENT_CACHE"); mode && !strcmp(mode, "temp")) return;
+    const size_t prefix = temp[0] ? clientTempEmptiedAtBoot(temp) : 0;
+    if (!prefix) return;
+    const char *home = getenv("HOME");
+    if (!home || home[0] != '/')
+        if (const passwd *user = getpwuid(getuid()); user && user->pw_dir) home = user->pw_dir;
+    if (!home || home[0] != '/' || clientTempEmptiedAtBoot(home) || !strncmp(home, "/var/empty", 10) || !strncmp(home, "/private/var/empty", 18)) return;
+    char name[128] = {};
+    strlcpy(name, temp + prefix, sizeof name);
+    name[strcspn(name, "/")] = 0;
+    if (!clientCacheName(name)) {
+        name[0] = 0;
+        if (CFBundleRef bundle = CFBundleGetMainBundle())
+            if (CFStringRef identifier = CFBundleGetIdentifier(bundle)) CFStringGetCString(identifier, name, sizeof name, kCFStringEncodingUTF8);
+        if (!clientCacheName(name)) strlcpy(name, getprogname(), sizeof name);
+        if (!clientCacheName(name)) return;
+    }
+    char caches[512];
+    snprintf(caches, sizeof caches, "%s/Library/Caches", home);
+    struct stat st = {};
+    if (stat(caches, &st) != 0 || !S_ISDIR(st.st_mode)) return;
+    char folder[512];
+    if ((size_t)snprintf(folder, sizeof folder, "%s/%s", caches, name) >= sizeof folder - 8) return;
+    mkdir(folder, 0700);
+    if (access(folder, W_OK) != 0) return;
+    if (strlcpy(out, folder, size) >= size - 1) {out[0] = 0; return;}
+    strlcat(out, "/", size);
+}
