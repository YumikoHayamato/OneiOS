OSArray *oneiosControls(bool volume) {
    OSArray *list = OSArray::withCapacity(1);
    if (!list || !volume) return list;
    OSDictionary *c = OSDictionary::withCapacity(12), *range = OSDictionary::withCapacity(4);
    OSArray *map = OSArray::withCapacity(1);
    if (c && range && map) {
        setNumber(c, "control ID", OneiosVolumeID);
        setNumber(c, "base class", 0x6c65766c);   // 'levl'
        setNumber(c, "class", 0x766c6d65);        // 'vlme'
        setNumber(c, "scope", 0x6f757470);        // 'outp'
        setNumber(c, "element", 0);
        c->setObject("read only", kOSBooleanFalse);
        setNumber(c, "value", oneios_speaker_volume);
        setNumber(c, "minimum value", 0);
        setNumber(c, "maximum value", OneiosVolumeSteps);
        setNumber(range, "start int value", 0);
        setNumber(range, "start db value", uint64_t(int64_t(-64) * (int64_t(1) << 32)), 64);
        setNumber(range, "integer steps", OneiosVolumeSteps);
        setNumber(range, "db per step", uint64_t(1) << 31, 64);   // 0.5 dB
        map->setObject(range);
        c->setObject("range map", map);
        list->setObject(c);
    }
    OSSafeReleaseNULL(c); OSSafeReleaseNULL(range); OSSafeReleaseNULL(map);
    return list;
}
// One period of the speaker at the volume's gain, in place (480 multiplies a 5 ms period; nothing at 0 dB).
void oneiosVolume(int16_t *s, uint32_t n) {
    const int32_t g = int32_t(oneios_speaker_gain);
    if (g >= 65536) return;
    for (uint32_t i = 0; i < n; i++) s[i] = int16_t((int32_t(s[i]) * g) >> 16);
}
// OneiOS (take18): the Mic's input data sources, as an iPhone's built-in microphone has them. VirtualAudio's route
// for recording (RoutingHandler_PlaybackAndRecord_GenericConfig1) sets the built-in mic's sub-ports through the
// device's input data sources (SubPortPolicy: AudioObjectGetPropertyDataSize of ['ssrc', 'inpt', 0]) and gives the
// whole route up when the device has none (take17: "Error getting data size of property [ssrc/inpt/0] on device 37",
// then "Routing is not supported", 30 times): Voice Memos' engine saw an input of 0 Hz (AURemoteIO -10851) and
// Safari's capture did not start (-66637), and the HAL never asked the Mic for StartIO. 24A446's HAL serves 'ssrc'
// from the scope's data source control ('dsrc', a selector: HALB_Info::TranslateDeviceAddressToControlAddress), whose
// items are its "selectors" ({"value": ID, "name": text}) and, a multi-selector, its "value" an array of the
// selected IDs (HALS_IOA2UCDevice::CopySelectorControlInfo_SelectorMap/_MultiSelectorValue). VirtualAudio reads and
// sets a list (the size over 4). The IDs are an iPhone's microphones as VirtualAudio's built-in mic tables name them
// ('mc01' bottom, 'mc02' front, 'mc03' back, 'mc04' a second bottom one; 1835216945.. as AVAudioSession shows them):
// every one of them is the one mono stream here. The HAL changes the selection by SetControlValue (selector 2) or
// SetMultiControlValue (selector 8: the control ID and the IDs in, the IDs taken out), and every ID asked is taken.
enum : uint32_t { OneiosMicSourceID = 2, OneiosMicSources = 4 };
const uint32_t oneios_mic_source_ids[OneiosMicSources] = { 0x6d633031, 0x6d633032, 0x6d633033, 0x6d633034 };   // 'mc01'..'mc04'
const char *const oneios_mic_source_names[OneiosMicSources] = { "Bottom", "Front", "Back", "Bottom 2" };
volatile uint32_t oneios_mic_selected[OneiosMicSources] = { 0x6d633031 }, oneios_mic_selected_count = 1, oneios_mic_source_sets;
OSArray *oneiosMicControls() {
    OSArray *list = OSArray::withCapacity(1), *items = OSArray::withCapacity(OneiosMicSources), *value = OSArray::withCapacity(OneiosMicSources);
    OSDictionary *c = OSDictionary::withCapacity(12);
    if (list && items && value && c) {
        setNumber(c, "control ID", OneiosMicSourceID);
        setNumber(c, "base class", 0x736c6374);   // 'slct'
        setNumber(c, "class", 0x64737263);        // 'dsrc'
        setNumber(c, "scope", 0x696e7074);        // 'inpt'
        setNumber(c, "element", 0);
        c->setObject("read only", kOSBooleanFalse);
        c->setObject("multi-selector", kOSBooleanTrue);
        for (uint32_t i = 0; i < OneiosMicSources; i++) {
            OSDictionary *item = OSDictionary::withCapacity(2);
            OSString *name = OSString::withCString(oneios_mic_source_names[i]);
            if (item && name) { setNumber(item, "value", oneios_mic_source_ids[i]); item->setObject("name", name); items->setObject(item); }
            OSSafeReleaseNULL(item); OSSafeReleaseNULL(name);
        }
        const uint32_t n = oneios_mic_selected_count < OneiosMicSources ? oneios_mic_selected_count : OneiosMicSources;
        for (uint32_t i = 0; i < n; i++)
            if (OSNumber *id = OSNumber::withNumber(uint64_t(oneios_mic_selected[i]), 32)) { value->setObject(id); id->release(); }
        c->setObject("selectors", items);
        c->setObject("value", value);
        list->setObject(c);
    }
    OSSafeReleaseNULL(items); OSSafeReleaseNULL(value); OSSafeReleaseNULL(c);
    return list;
}
