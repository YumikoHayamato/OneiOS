# Kernel configuration of the native OneiOS kernel (arm64e, xnu-12377): XNU alone at EL1, first on QEMU's virt board
# (docs/native.md), built by kernel/build-native.sh. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the build.
# The fragments of the arm64e and iOS 27 profiles come first (board.toml [kernel] config_fragments).
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# As the DroidVM iPadOS 27 board: xnu-12377's OSKext starts the original corecrypto through the source provider's
# entry, which exists only in source mode.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# The kernel collection of 24A446 is an MH_FILESET; XnuPrelink's fileset emitter links this kernel into it.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_BOOT_PROGRESS=n
# The board's archives (oneios-tool kernel gen board), started by oneios_board_late_start, and the disks
# (kernel/patches/oneios-hosted/storage, oneios-tool kernel gen storage: OneiOSHostedDisk on a mapped virtio-mmio window,
# each chunk of a read-only image checked against the hash list the loader puts in its node), started by
# native_source_storage_start. Then the software AES (oneios-tool kernel gen aes: the IOAESAccelerator AppleImage4 waits for, without
# which IOResources never finishes matching and the disks get no BSD nodes) and the key store (gen keystore: launchd looks
# for an AppleKeyStore service), as the hosted kernel has them; the GPU (gen gpu: Droid-VM's virtio-gpu transport,
# which the display's scanout uses; without a 3D device, "display only"); and touch and keys (gen hid: NativeHidInput
# fed by Droid-VM's virtio-input transport: on the bench QEMU's virtio-tablet-device as one finger and its keyboard).
# Then the speaker (gen audio), the Wi-Fi (gen net) and the video decoder (gen codec: VideoToolbox's paravirtualized decoder
# over crosvm's virtio-media decoder; it starts only with oneios-codec=1, which xnuloader-crosvm --media gives).
# In the hosted kernel's link order; kernel/build-native.sh adds them, and the display (gen display), to the archives.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/oneios-drivers/liboneiosdrivers.a -Wl,-force_load,{tree}/build/oneios-board/liboneiosboard.a -Wl,-force_load,{tree}/build/oneios-hosted-storage/liboneioshostedstorage.a -Wl,-force_load,{tree}/build/oneios-gpu/liboneiosgpu.a -Wl,-force_load,{tree}/build/oneios-aes/liboneiosaes.a -Wl,-force_load,{tree}/build/oneios-keystore/liboneioskeystore.a -Wl,-force_load,{tree}/build/oneios-hid/liboneioshid.a -Wl,-force_load,{tree}/build/oneios-audio/liboneiosaudio.a -Wl,-force_load,{tree}/build/oneios-net/liboneiosnet.a -Wl,-force_load,{tree}/build/oneios-codec/liboneioscodec.a"
# The display (kernel/patches/oneios-hosted/display): UniXNU's NativeMobileDisplay under the collection's
# IOMobileFramebufferLegacy, frames to the virtio-gpu scanout (QEMU's virtio-gpu-device on the bench). UniXNU's build links
# build/native-legacy-display/libNativeLegacyDisplay.late.a and compiles bsd_init's two calls; 0076 turns the display on
# as the hosted kernel has it (oneios-display=0 turns it off).
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# The hosted kernel's OS layer without its host (kernel/patches/oneios-hosted/0076-native-os-layer.patch: the image set's
# root, Data, seed and launch policy, the boot manifest's /chosen, the AES and key store starts, iOS 27's shared region).
CONFIG_XNU_ONEIOS_NATIVE=y
# The root as the hosted kernel's (oneios_hosted_defconfig says why each is on): the OS volume is accepted as root
# because its disk is a verified one, here because this kernel checks every chunk it reads against the image set's
# hash list (the disk node's "oneios,hash-list" and "oneios,verified", written by the loader: runtime/loader/tools/
# xnuloader-qemu.c on the bench). The SystemOS volume over / as a union, the boot manifest, the Data volume at
# /private/var (first start: newfs_apfs, then the seed unpacked in the kernel) and the board's launch policy.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_BOARD_LAUNCH_POLICY=y
# A placeholder UniXNU's build insists on; the volume UUIDs come from the disks' nodes ("oneios,volume-uuid").
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
