+#if XNU_HOSTED || XNU_ONEIOS_NATIVE
+/*
+ * OneiOS (0084): what the memory looks like and what jetsam does, on the console with printf: memorystatus_log's own
+ * lines go quiet once startup serial logging ends. Only lines: no decision is changed.
+ *
+ * The band changes of backboardd and SpringBoard, kept in a ring here (proc_list_lock is held: nothing may be printed)
+ * and printed by the next kill or the next report, with the process on whose behalf it was made (kernel_task for
+ * jetsam's own). A change the same as one still to be printed only counts there, so a process that goes back and forth
+ * takes two entries; when the ring is full the first changes stay and the later ones are counted as lost.
+ */
+#define ONEIOS_BANDS 64
+static struct {
+	char    name[MAXCOMLEN + 1], by[MAXCOMLEN + 1];
+	int     pid, by_pid;
+	int32_t from, to, requested, assertion;
+	uint32_t options, again;
+} oneios_band_changes[ONEIOS_BANDS];
+static uint32_t oneios_bands_made, oneios_bands_printed, oneios_bands_lost;     /* proc_list_lock */
+
+static void
+oneios_band_note_locked(proc_t p, int32_t to, memstat_priority_options_t options)
+{
+	proc_t by = current_proc();
+
+	if (p->p_memstat_effectivepriority == to ||
+	    (strcmp(p->p_name, "backboardd") && strcmp(p->p_name, "SpringBoard"))) {
+		return;
+	}
+	for (uint32_t i = oneios_bands_printed; i != oneios_bands_made; i++) {
+		typeof(oneios_band_changes[0]) *old = &oneios_band_changes[i % ONEIOS_BANDS];
+		if (old->pid == proc_getpid(p) && old->from == p->p_memstat_effectivepriority && old->to == to &&
+		    old->by_pid == (by ? proc_getpid(by) : -1) && old->requested == p->p_memstat_requestedpriority &&
+		    old->assertion == p->p_memstat_assertionpriority && old->options == (uint32_t)options) {
+			old->again++;
+			return;
+		}
+	}
+	if (oneios_bands_made - oneios_bands_printed == ONEIOS_BANDS) {
+		oneios_bands_lost++;
+		return;
+	}
+	typeof(oneios_band_changes[0]) *c = &oneios_band_changes[oneios_bands_made++ % ONEIOS_BANDS];
+	strlcpy(c->name, p->p_name, sizeof(c->name));
+	strlcpy(c->by, by ? by->p_name : "?", sizeof(c->by));
+	c->pid = proc_getpid(p);
+	c->by_pid = by ? proc_getpid(by) : -1;
+	c->from = p->p_memstat_effectivepriority;
+	c->to = to;
+	c->requested = p->p_memstat_requestedpriority;
+	c->assertion = p->p_memstat_assertionpriority;
+	c->options = (uint32_t)options;
+	c->again = 0;
+}
+
+static void
+oneios_bands_print(void)
+{
+	for (;;) {
+		typeof(oneios_band_changes[0]) c;
+		uint32_t lost;
+
+		proc_list_lock();
+		if (oneios_bands_printed == oneios_bands_made) {
+			proc_list_unlock();
+			return;
+		}
+		c = oneios_band_changes[oneios_bands_printed++ % ONEIOS_BANDS];
+		lost = oneios_bands_lost;
+		oneios_bands_lost = 0;
+		proc_list_unlock();
+		printf("oneios-band: %s[%d] %d -> %d (requested %d, assertion %d, options 0x%x) by %s[%d], again %u, lost %u\n",
+		    c.name, c.pid, c.from, c.to, c.requested, c.assertion, c.options, c.by, c.by_pid, c.again, lost);
+	}
+}
+
+/* In MiB; called every 10 s by the GPU archive's report thread (gpu/OneiOSAdreno.cpp). */
+void oneios_memory_report(uint32_t every);
+void
+oneios_memory_report(uint32_t every)
+{
+#define ONEIOS_MIB(pages) ((uint32_t)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+	printf("oneios-memory: %u s: available %u MiB (critical %u, idle %u, soft %u), free %u, wired %u, active %u, inactive %u, "
+	    "speculative %u, compressor %u\n", every, ONEIOS_MIB(MEMORYSTATUS_LOG_AVAILABLE_PAGES),
+	    ONEIOS_MIB(memstat_critical_threshold), ONEIOS_MIB(memstat_idle_threshold), ONEIOS_MIB(memstat_soft_threshold),
+	    ONEIOS_MIB(vm_page_free_count), ONEIOS_MIB(vm_page_wire_count), ONEIOS_MIB(vm_page_active_count),
+	    ONEIOS_MIB(vm_page_inactive_count), ONEIOS_MIB(vm_page_speculative_count), ONEIOS_MIB(vm_compressor_pool_size()));
+	oneios_bands_print();
+}
